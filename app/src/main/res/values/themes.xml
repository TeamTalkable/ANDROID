<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Talkable" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/main</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/main_3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>

        <item name="android:textColorHighlight">@color/tv_highlight</item>
        <item name="android:colorAccent">@color/tv_highlight</item>
        <item name="colorControlNormal">@color/main</item>
    </style>

    <style name="Theme.Talkable" parent="Base.Theme.Talkable" />

    <style name="Theme.Talkable.Splash">
        <item name="android:windowBackground">@drawable/background_splash_screen</item>
    </style>
</resources>