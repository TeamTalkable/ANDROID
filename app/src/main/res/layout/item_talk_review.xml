<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.talkable.presentation.talk.feedback.model.TalkFeedbackModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/main_3"
        android:paddingBottom="23dp">

        <ImageView
            android:id="@+id/iv_talk_review_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="26dp"
            android:src="@drawable/ic_my_page_talk_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_talk_review_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="대화 시간"
            android:textAppearance="@style/TextAppearance.Talkable.sub_m_14"
            android:textColor="@color/font_3"
            app:layout_constraintBottom_toBottomOf="@id/iv_talk_review_time"
            app:layout_constraintStart_toEndOf="@id/iv_talk_review_time"
            app:layout_constraintTop_toTopOf="@id/iv_talk_review_time" />

        <TextView
            android:id="@+id/tv_talk_review_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@{model.talkTime + `M`}"
            android:textAppearance="@style/TextAppearance.Talkable.main_b_20"
            app:layout_constraintBottom_toBottomOf="@id/tv_talk_review_time_label"
            app:layout_constraintStart_toEndOf="@id/tv_talk_review_time_label"
            app:layout_constraintTop_toTopOf="@id/tv_talk_review_time_label"
            tools:text="10M" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>