<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_3">

        <TextView
            android:id="@+id/tv_setting_alarm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="94dp"
            android:text="@string/tv_setting_alarm_title"
            android:textAppearance="@style/TextAppearance.Talkable.b_24"
            android:textColor="@color/main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_setting_alarm_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/tv_setting_alarm_description"
            android:textAppearance="@style/TextAppearance.Talkable.m_18"
            android:textColor="@color/gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_setting_alarm_title"
            app:layout_constraintTop_toBottomOf="@id/tv_setting_alarm_title" />

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/shape_white_fill_20_rec"
            app:layout_constraintBottom_toBottomOf="@id/picker_select_alarm_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/picker_select_alarm_time" />

        <NumberPicker
            android:id="@+id/picker_select_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:selectionDividerHeight="0dp"
            android:theme="@style/AlarmNumberPicker"
            android:timePickerMode="spinner"
            app:layout_constraintBottom_toTopOf="@id/tv_setting_alarm_cap"
            app:layout_constraintEnd_toStartOf="@id/picker_select_alarm_time_hour"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_setting_alarm_description" />

        <NumberPicker
            android:id="@+id/picker_select_alarm_time_hour"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:selectionDividerHeight="0dp"
            android:theme="@style/AlarmNumberPicker"
            android:timePickerMode="spinner"
            android:lineSpacingExtra="10dp"
            app:layout_constraintBottom_toBottomOf="@id/picker_select_alarm_time"
            app:layout_constraintEnd_toStartOf="@id/tv_select_alarm_time"
            app:layout_constraintStart_toEndOf="@id/picker_select_alarm_time"
            app:layout_constraintTop_toTopOf="@id/picker_select_alarm_time" />

        <TextView
            android:id="@+id/tv_select_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textAppearance="@style/TextAppearance.Talkable.b_24"
            app:layout_constraintBottom_toBottomOf="@id/picker_select_alarm_time"
            app:layout_constraintEnd_toStartOf="@id/picker_select_alarm_minute"
            app:layout_constraintStart_toEndOf="@id/picker_select_alarm_time_hour"
            app:layout_constraintTop_toTopOf="@id/picker_select_alarm_time" />

        <NumberPicker
            android:id="@+id/picker_select_alarm_minute"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="20dp"
            android:selectionDividerHeight="0dp"
            android:theme="@style/AlarmNumberPicker"
            android:timePickerMode="spinner"
            app:layout_constraintBottom_toBottomOf="@id/picker_select_alarm_time_hour"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_select_alarm_time"
            app:layout_constraintTop_toTopOf="@id/picker_select_alarm_time_hour" />

        <TextView
            android:id="@+id/tv_setting_alarm_cap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/tv_setting_alarm_cap"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Talkable.sub_r_14"
            android:textColor="@color/gray"
            app:layout_constraintBottom_toTopOf="@id/btn_setting_alarm"
            app:layout_constraintEnd_toEndOf="@id/btn_setting_alarm"
            app:layout_constraintStart_toStartOf="@id/btn_setting_alarm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_setting_alarm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="38dp"
            android:layout_marginBottom="103dp"
            android:paddingVertical="20dp"
            android:text="@string/btn_setting_alarm"
            android:textAppearance="@style/TextAppearance.Talkable.button_b_18"
            android:textColor="@color/font_5"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>