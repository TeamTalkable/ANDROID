<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:elevation="1dp"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_talk_feedback_user_before_answer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_gray_2_fill_12_rect"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:textAppearance="@style/TextAppearance.Talkable.sub_m_14"
        android:textColor="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/dummy" />

    <ImageView
        android:id="@+id/iv_talk_feedback_part_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_feedback_arrow_down"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_talk_feedback_user_before_answer" />

    <TextView
        android:id="@+id/tv_talk_feedback_user_after_answer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_main3_line_4_rect"
        android:backgroundTint="@color/main_3"
        android:paddingVertical="20dp"
        android:paddingStart="37dp"
        android:paddingEnd="13dp"
        android:textAppearance="@style/TextAppearance.Talkable.m_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_talk_feedback_part_arrow"
        tools:text="@string/dummy" />

    <ImageView
        android:id="@+id/iv_talk_feedback_sound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_saved_listen_unselected"
        app:layout_constraintStart_toStartOf="@id/tv_talk_feedback_user_after_answer"
        app:layout_constraintTop_toTopOf="@id/tv_talk_feedback_user_after_answer"
        app:tint="@color/gray" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:background="@drawable/shape_font4_fill_40_rect"
        android:backgroundTint="@color/main"
        android:padding="6dp"
        android:text="교정된 문장"
        android:textAppearance="@style/TextAppearance.Talkable.sub_r_12"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/tv_talk_feedback_user_after_answer"
        app:layout_constraintStart_toStartOf="@id/tv_talk_feedback_user_after_answer"
        app:layout_constraintTop_toTopOf="@id/tv_talk_feedback_user_after_answer" />
</androidx.constraintlayout.widget.ConstraintLayout>